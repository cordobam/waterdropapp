<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plantas_edit_plant_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A3A1F"
            android:layout_marginBottom="16dp"/>

        <!-- CARD FOTO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#C8DFC0"
            app:strokeWidth="1.5dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/imgPlantaEditar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface_card"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_planta"/>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarFoto"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/plantas_dialog_change_photo"
            android:textSize="14sp"
            android:textColor="#3A7D44"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="#3A7D44"
            app:strokeColor="#3A7D44"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="20dp"/>

        <!-- NOMBRE -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/plantas_name_hint"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxStrokeColor="#C8DFC0"
            app:hintTextColor="#3A7D44">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- DIAS VERANO -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/plantas_dialog_days_summer_hint"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxStrokeColor="#C8DFC0"
            app:hintTextColor="#3A7D44"
            app:startIconDrawable="@android:drawable/ic_menu_recent_history"
            app:startIconTint="#3A7D44">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- DIAS INVIERNO -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/plantas_dialog_days_winter_hint"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxStrokeColor="#C8DFC0"
            app:hintTextColor="#3A7D44"
            app:startIconDrawable="@android:drawable/ic_menu_recent_history"
            app:startIconTint="#3A7D44">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDiasInv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#E8F0E4"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"/>

        <!-- GRUPO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plantas_group_label"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spGrupos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner_green"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <!-- BOTONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/common_cancel"
                android:textColor="#E53935"
                app:strokeColor="#E53935"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/common_save"
                android:textColor="#FFFFFF"
                app:cornerRadius="14dp"
                android:backgroundTint="#3A7D44"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
