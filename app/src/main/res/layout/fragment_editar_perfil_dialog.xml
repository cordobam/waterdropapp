<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_edit_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A3A1F"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="50dp"
            app:cardElevation="0dp"
            app:strokeColor="#C8DFC0"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/imgAvatarPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:scaleType="centerCrop"
                android:background="#EAF3DE" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_name"
            android:textSize="13sp"
            android:textColor="#4E6E50"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/profile_name_hint"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_photo_url"
            android:textSize="13sp"
            android:textColor="#4E6E50"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etFotoUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/hint_url"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_city"
            android:textSize="13sp"
            android:textColor="#4E6E50"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etCiudad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/hint_city"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/common_save_changes"
            android:backgroundTint="#3A7D44"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/common_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="#3A7D44"
            app:strokeColor="#C8DFC0"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>