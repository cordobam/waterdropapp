<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vivero_form_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A3A1F"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_name"
            android:textSize="13sp"
            android:textColor="#4E6E50" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/vivero_name_hint"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_description"
            android:textSize="13sp"
            android:textColor="#4E6E50" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/vivero_description_hint"
            android:textSize="14sp"
            android:minLines="3"
            android:gravity="top"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vivero_address"
            android:textSize="13sp"
            android:textColor="#4E6E50" />

        <EditText
            android:id="@+id/etDireccion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/vivero_address_hint"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_city"
            android:textSize="13sp"
            android:textColor="#4E6E50" />

        <EditText
            android:id="@+id/etCiudad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/hint_city"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_neighborhood"
            android:textSize="13sp"
            android:textColor="#4E6E50" />

        <EditText
            android:id="@+id/etBarrio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/form_neighborhood_hint"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vivero_phone"
            android:textSize="13sp"
            android:textColor="#4E6E50" />

        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/vivero_phone_hint"
            android:textSize="14sp"
            android:inputType="phone"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vivero_hours"
            android:textSize="13sp"
            android:textColor="#4E6E50" />

        <EditText
            android:id="@+id/etHorario"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/vivero_hours_hint"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vivero_specialties"
            android:textSize="13sp"
            android:textColor="#4E6E50" />

        <EditText
            android:id="@+id/etEspecialidades"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/vivero_specialties_hint"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vivero_image_url"
            android:textSize="13sp"
            android:textColor="#4E6E50" />

        <EditText
            android:id="@+id/etImagenUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/hint_url"
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="8dp"
            android:layout_marginBottom="12dp" />


        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/vivero_save"
            android:backgroundTint="#3A7D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/common_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="#3A7D44"
            app:strokeColor="#C8DFC0"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
