<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#C8DFC0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="4dp">

        <!-- IMAGEN -->
        <ImageView
            android:id="@+id/imgPublicacion"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:background="#EAF3DE"
            android:src="@drawable/ic_planta"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- BADGE CATEGORÍA (esquina superior derecha) -->
        <TextView
            android:id="@+id/tvCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Planta"
            android:textSize="10sp"
            android:textColor="#27500A"
            android:background="@drawable/bg_categoria_badge"
            app:layout_constraintTop_toTopOf="@+id/imgPublicacion"
            app:layout_constraintEnd_toEndOf="@+id/imgPublicacion" />

        <!-- INFO DEBAJO DE LA IMAGEN -->
        <LinearLayout
            android:id="@+id/layoutInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@+id/imgPublicacion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- NOMBRE -->
            <TextView
                android:id="@+id/tvNombrePublicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre planta"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A3A1F"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- UBICACION -->
            <TextView
                android:id="@+id/tvUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Barrio · Ciudad"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- PRECIO, TRUEQUE Y BOTÓN OFERTAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPrecio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="$1.500"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#3A7D44"/>

                <TextView
                    android:id="@+id/tvTrueque"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="🔄 Trueque"
                    android:textSize="11sp"
                    android:textColor="#E67E22"
                    android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOfertar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Ofertar"
                    android:textSize="11sp"
                    app:strokeColor="#3A7D44"
                    android:textColor="#3A7D44"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>