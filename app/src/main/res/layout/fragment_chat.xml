<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#1A3A1F"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgChatPublicacion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_planta"
            android:background="#EAF3DE"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat sobre publicación"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvChatCon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conversación con Usuario"
                android:textSize="12sp"
                android:textColor="#B8D4B8"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/btnCerrarChat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF"/>

    </LinearLayout>

    <!-- RECYCLER VIEW MENSAJES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        app:stackFromEnd="true"
        android:transcriptMode="alwaysScroll"/>

    <!-- INPUT MENSAJE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etMensaje"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="Escribe un mensaje..."
            android:textSize="14sp"
            android:background="@drawable/border_top_gray"
            android:paddingStart="12dp"
            android:maxLines="4"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarMensaje"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:icon="@android:drawable/ic_menu_send"
            android:iconTint="#FFFFFF"
            android:backgroundTint="#3A7D44"/>

    </LinearLayout>

</LinearLayout>